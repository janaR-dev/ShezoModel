# Copy to .env and fill in. Never commit real keys.
SHEZO_HOST=127.0.0.1
SHEZO_PORT=8080

# Storage. "mysql" is the default and uses the local MariaDB/MySQL server that
# phpMyAdmin manages; the database is created on first run. Set
# SHEZO_DB_ENGINE=sqlite (plus SHEZO_DB) to use a local file instead.
SHEZO_DB_ENGINE=mysql
SHEZO_MYSQL_URL=mysql://root@127.0.0.1:3306/shezo
SHEZO_DB=shezo.db

# Optional: OpenAI-compatible endpoint for narration. Without it the model runs
# on the deterministic offline narrator.
# SHEZO_LLM_API_KEY=
# SHEZO_LLM_BASE_URL=https://api.openai.com/v1
# SHEZO_LLM_MODEL=gpt-4o-mini

# Optional: extra care-team delivery channel (email/SMS/push relay).
# SHEZO_WEBHOOK_URL=
